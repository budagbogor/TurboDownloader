{
  "name": "turbodownloader",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron.js",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist-server/server.js",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:all": "npm run build && npm run build:server",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server",
    "lint": "tsc --noEmit",
    "cap:sync": "npx cap sync",
    "cap:add-android": "npx cap add android",
    "cap:open-android": "npx cap open android",
    "electron:start": "npm run build:all && electron .",
    "electron:build": "npm run build:all && electron-builder build --win",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "build": {
    "appId": "com.budagbogor.turbodownloader",
    "productName": "TurboDownloader",
    "win": {
      "target": "nsis"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "electron.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/youtube-dl-exec/bin",
        "to": "bin/youtube-dl",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/local-notifications": "^8.0.2",
    "@distube/ytdl-core": "^4.16.12",
    "@google/genai": "^1.29.0",
    "@jerrycoder/instagram-api": "^2.5.9",
    "@renpwn/fb-downloader": "^1.0.16",
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/api": "^1.6.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.13.6",
    "better-sqlite3": "^12.4.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fluent-ffmpeg": "^2.1.3",
    "framer-motion": "^12.35.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "play-dl": "^1.9.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.5.0",
    "uuid": "^13.0.0",
    "vite": "^6.2.0",
    "ws": "^8.19.0",
    "youtube-dl-exec": "^3.1.3",
    "youtubei.js": "^18.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^1.6.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^9.0.10"
  }
}
